{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SXT Monitor",
  "version": "0.2.1",
  "identifier": "com.oncoders.mikrotik-sxt-monitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SXT Monitor",
        "width": 720,
        "height": 650,
        "minWidth": 400,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
  "updater": {
    "endpoints": [
      "https://github.com/ris3two/mikrotik-sxt-monitor/releases/latest/download/latest.json"
    ],
    "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGQ0NCNUQ4RTIxQjU5RUMKUldUc1dSdmkyTFhNandQTjZ1UHVBNWxSQkRVZHg2UzJZT2F5anN6Y2JoVU1MdUwwazYvaERqUkwK"
  }
}
}
